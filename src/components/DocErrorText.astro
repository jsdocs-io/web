---
import type { DocErrorText as _DocErrorText } from "@microsoft/tsdoc";
import { mdToHtml } from "../../lib/components/md-to-html";

interface Props {
  errorText: _DocErrorText;
}

const {
  errorText: { text },
} = Astro.props;
const html = await mdToHtml(text);
---

<Fragment set:html={html} />

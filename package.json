{
  "name": "@jsdocs-io/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && svelte-check --no-tsconfig",
    "build": "node -v && bun --revision && bun run check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "prettier --check . && oxlint --type-aware",
    "format": "prettier --write .",
    "test": "PINO_LOG_LEVEL=silent vitest",
    "test:ci": "PINO_LOG_LEVEL=silent vitest run --coverage --bail 1",
    "pre-push": "node -v && bun --revision && bun i && bun run lint && bun run build && bun run test:ci",
    "shiki:codegen": "bun run scripts/shiki-codegen.ts"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/node": "^10.0.1",
    "@astrojs/svelte": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1008.0",
    "@braintree/sanitize-url": "^7.1.2",
    "@jsdocs-io/extractor": "^2.1.0",
    "@microsoft/tsdoc": "^0.16.0",
    "alpinejs": "^3.15.8",
    "astro": "^6.0.4",
    "dompurify": "^3.3.3",
    "effect": "^3.19.19",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "go-go-try": "^8.0.0",
    "hosted-git-info": "^9.0.2",
    "jsdom": "^28.1.0",
    "lodash-es": "^4.17.23",
    "marked": "^17.0.4",
    "memoize": "^10.2.0",
    "nanoid": "^5.1.6",
    "new-github-issue-url": "^1.1.0",
    "pathe": "^2.0.3",
    "pino": "^10.3.1",
    "read-pkg": "^10.1.0",
    "runed": "^0.37.1",
    "shiki": "^4.0.2",
    "svelte": "^5.53.11",
    "trim-newlines": "^5.0.0",
    "url-join": "^5.0.0",
    "validate-npm-package-name": "^7.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/ts-plugin": "^1.10.7",
    "@astrojs/vercel": "^10.0.0",
    "@iconify-json/lucide": "^1.2.97",
    "@smithy/util-stream": "^4.5.19",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/alpinejs": "^3.13.11",
    "@types/anchor-js": "^5.0.3",
    "@types/dompurify": "^3.2.0",
    "@types/hosted-git-info": "^3.0.5",
    "@types/jsdom": "^28.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitest/coverage-v8": "^4.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "basecoat-css": "^0.3.11",
    "daisyui": "^5.5.19",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
